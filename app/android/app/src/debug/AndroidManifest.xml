<?xml version="1.0" encoding="utf-8"?>
<!--
  D-011：调试面只允许存在 debug 变体。
  这四个缺失模块页在主 manifest 里是 exported=false；这里只对 debug 覆盖为 true，
  让 AT 能用 `adb shell am start -n com.luopan.fengshui/.XxxActivity` 直达。
  release 包由主 manifest 决定，仍是 false，且不存在本文件的覆盖。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <activity
            android:name=".SettingActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity
            android:name=".ToolsManagerActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity
            android:name=".InterestListActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity
            android:name=".SaveInterestActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity
            android:name=".FeatureFlagsActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-09 天气：只在 debug 变体导出，AT 可 am start 直达 -->
        <activity
            android:name=".WeatherActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-06 看山脉：只在 debug 变体导出 -->
        <activity
            android:name=".MountainActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-07 看水系：只在 debug 变体导出 -->
        <activity
            android:name=".WaterActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-10 历史影像：只在 debug 变体导出 -->
        <activity
            android:name=".HistoryImageActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-16 地理影像：只在 debug 变体导出 -->
        <activity
            android:name=".GeographicImageryActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-02 超清地图：只在 debug 变体导出 -->
        <activity
            android:name=".SuperMapActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-14 钓点：只在 debug 变体导出 -->
        <activity
            android:name=".FishingActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-03 海拔查询：只在 debug 变体导出 -->
        <activity
            android:name=".ElevationActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-05 数据叠加：只在 debug 变体导出 -->
        <activity
            android:name=".OverlayActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-08 探索：只在 debug 变体导出 -->
        <activity
            android:name=".DiscoveryActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-18 盘面目录：扩展已有 CompassListActivity，仅 debug 导出供 AT 直达 -->
        <activity
            android:name=".CompassListActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- F-15 轨迹：仅 debug 导出供 AT 直达 -->
        <activity
            android:name=".TrackListActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity
            android:name=".TrackDetailActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity
            android:name=".TrackReplayActivity"
            android:exported="true"
            tools:replace="android:exported" />

    </application>
</manifest>
