<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- F-15 轨迹记录：前台服务 + 常驻通知 + 保活引导（不申请「始终允许后台定位」） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Luopan">

        <activity
            android:name=".CompassListActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan" />

        <!--
          缺失模块页（设置 / 工具管理 / 收藏点 + 功能开关）。
          主 manifest 一律 exported=false（D-011：release 不许暴露调试面）；
          AT 的 `am start -n com.luopan.fengshui/.XxxActivity` 直达只在 debug 变体生效，
          由 src/debug/AndroidManifest.xml 用 tools:replace 覆盖。
          入口：设置/收藏点等按 00-UI-ROUTES.md，功能开关挂「更多」面板标题栏。
        -->
        <activity
            android:name=".SettingActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <activity
            android:name=".FeatureFlagsActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-09 天气（LC地图 新建页）：主 manifest exported=false，AT 直达只在 debug 覆盖 -->
        <activity
            android:name=".WeatherActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-06 看山脉（LC地图 新建页）：同上，debug 才导出 -->
        <activity
            android:name=".MountainActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-07 看水系（LC地图 新建页） -->
        <activity
            android:name=".WaterActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-10 历史影像（LC地图 新建页）：Esri Wayback 时相 + 本机快照 -->
        <activity
            android:name=".HistoryImageActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-16 地理影像（LC地图 新建页）：公开图库（Bing 每日壁纸）+ 署名 -->
        <activity
            android:name=".GeographicImageryActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-02 超清地图（LC地图 新建页）：z18 本地拼接 + 磁盘/内存缓存 -->
        <activity
            android:name=".SuperMapActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-14 钓点（LC地图 新建页）：公开水域 + 本机自建钓点 -->
        <activity
            android:name=".FishingActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-03 海拔查询（LC地图 新建页）：DEM 采样 + 逆地理 + 估算氧/压 -->
        <activity
            android:name=".ElevationActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-05 数据叠加（LC地图 新建页）：四页签 + 多图层开关/透明度 -->
        <activity
            android:name=".OverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-08 探索（LC地图 新建页）：三页签 + Wikimedia CC 素材 -->
        <activity
            android:name=".DiscoveryActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-15 轨迹（LC 自建）：列表 → 详情 → 回放；记录态由前台服务承担 -->
        <activity
            android:name=".TrackListActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <activity
            android:name=".TrackDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <activity
            android:name=".TrackReplayActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <service
            android:name=".TrackRecorderService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <activity
            android:name=".ToolsManagerActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <activity
            android:name=".InterestListActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan" />

        <activity
            android:name=".SaveInterestActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
