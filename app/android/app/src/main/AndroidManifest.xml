<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Luopan">

        <activity
            android:name=".CompassListActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan" />

        <!--
          缺失模块页（设置 / 工具管理 / 收藏点 + 功能开关）。
          主 manifest 一律 exported=false（D-011：release 不许暴露调试面）；
          AT 的 `am start -n com.luopan.fengshui/.XxxActivity` 直达只在 debug 变体生效，
          由 src/debug/AndroidManifest.xml 用 tools:replace 覆盖。
          入口：设置/收藏点等按 00-UI-ROUTES.md，功能开关挂「更多」面板标题栏。
        -->
        <activity
            android:name=".SettingActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <activity
            android:name=".FeatureFlagsActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-09 天气（LC地图 新建页）：主 manifest exported=false，AT 直达只在 debug 覆盖 -->
        <activity
            android:name=".WeatherActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-06 看山脉（LC地图 新建页）：同上，debug 才导出 -->
        <activity
            android:name=".MountainActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-07 看水系（LC地图 新建页） -->
        <activity
            android:name=".WaterActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <!-- F-10 历史影像（LC地图 新建页）：Esri Wayback 时相 + 本机快照 -->
        <activity
            android:name=".HistoryImageActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <activity
            android:name=".ToolsManagerActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan.Light" />

        <activity
            android:name=".InterestListActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan" />

        <activity
            android:name=".SaveInterestActivity"
            android:exported="false"
            android:theme="@style/Theme.Luopan" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
